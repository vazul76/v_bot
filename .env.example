# VirusTotal API Key (Optional - untuk /scan command)
VT_API_KEY=isi_api_key_virustotal_kamu_di_sini

# Groq API Key (Optional - untuk /tr translate command)
GROQ_API_KEY=isi_api_key_groq_kamu_di_sini

# Groq Model (Optional)
# Contoh: openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-20b

# Admin WhatsApp Number (Optional - untuk /health monitoring)
# Format: 628xxxxxxxxxx@s.whatsapp.net
ADMIN_NUMBER=628xxxxxxxxxx@s.whatsapp.net

# Cookies yt-dlp per platform (Optional)
# Path absolut ke cookies.txt hasil export browser
# YT_COOKIES=/path/to/youtube-cookies.txt
# IG_COOKIES=/path/to/instagram-cookies.txt
# FB_COOKIES=/path/to/facebook-cookies.txt
# X_COOKIES=/path/to/x-cookies.txt
# TT_COOKIES=/path/to/tiktok-cookies.txt
# Catatan: X_COOKIES hanya dipakai untuk fallback video HLS; foto/video X diambil via syndication API.
